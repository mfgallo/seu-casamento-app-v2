# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o ".env" — ele já está no .gitignore.

# --- API (backend whatsvg — Cognito + DynamoDB) ---
# URL base do backend FastAPI/Lambda (ver whatsvg/infra, output "api_base_url").
# Sem o "/" no final. Em dev local: http://localhost:8080 (uvicorn do whatsvg).
# VITE_API_URL é a mesma URL exposta ao browser (Vite injeta no bundle do
# client) — é pública por natureza, o browser fala com essa API diretamente.
API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080

# --- OpenAI (chat "Assistente Noiva") ---
# Gere em https://platform.openai.com/api-keys. Sem essa variável, o endpoint
# /api/chat responde 500 de forma controlada e o resto do site funciona normalmente.
OPENAI_API_KEY=
