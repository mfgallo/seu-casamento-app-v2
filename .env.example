# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o ".env" — ele já está no .gitignore.

# --- Supabase ---
# Painel do projeto Supabase > Project Settings > API.
# As variáveis com prefixo VITE_ são as mesmas, só que expostas ao browser
# (Vite as injeta no bundle do client). São seguras de expor: é a "publishable key",
# feita para uso público, protegida pelas políticas de RLS do banco.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Chave secreta (service role) — bypassa o RLS. Usada só no servidor
# (src/lib/auth.functions.ts, para criar usuários). NUNCA prefixar com VITE_,
# NUNCA expor ao client. Configure só como variável de ambiente do servidor
# (local: aqui no .env; produção: painel da Vercel).
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (chat "Assistente Noiva") ---
# Gere em https://platform.openai.com/api-keys. Sem essa variável, o endpoint
# /api/chat responde 500 de forma controlada e o resto do site funciona normalmente.
OPENAI_API_KEY=
